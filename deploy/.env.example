# =====================================================
# 生产环境配置（复制为 .env 后改）
# =====================================================

# ---------- 数据库 ----------
DB_USER=todo
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS
DB_NAME=todo_prod

# ---------- NextAuth.js ----------
# 生成方式：openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET_BASE64

# ---------- 域名 ----------
# 没域名先用 ECS 公网 IP（Caddy 自动申请证书失败时降级 HTTP）
DOMAIN=todo.your-domain.com

# ---------- 备案号（可选）----------
# 工信部要求网站底部标示备案编号。开源模板里不硬编码真实备案号，由部署方自己填。
# 留空 = 页脚不显示备案号（境内正式对外提供服务前必须填）。
# 注意：这个值会在**构建时**被内联进前端 bundle → 改完要重新 build 才生效。
# NEXT_PUBLIC_ICP_NUMBER=京ICP备00000000号-1
# NEXT_PUBLIC_POLICE_NUMBER=京公网安备11010802000000号

# ---------- 游客模式（可选，不配则登录页不显示「游客体验」）----------
# 游客模式：不用注册就能体验，所有游客数据归属到下面这个账号
# GUEST_PHONE    = 游客账号手机号
# GUEST_PASSWORD = 游客账号密码（务必与手机号不同，别用弱密码）
# 这两个值只在服务端使用，不会打进前端 bundle

# ---------- PostgreSQL 调优（deploy/postgresql.conf 已配） ----------
# ---------- Next.js（已配 NODE_OPTIONS=--max-old-space-size=512） ----------