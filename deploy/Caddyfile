# =====================================================
# 2026-10-20：备案下来了，开 HTTPS
# - juststartit.cn / www.juststartit.cn 自动申请 Let's Encrypt cert
# - 47.107.46.78.nip.io 保留 HTTP（备案是给 juststartit.cn 用的，nip.io 走 IP 跟备案无关）
# =====================================================

# HTTPS 入口：正式域名（备案后能用）
juststartit.cn, www.juststartit.cn {
	encode zstd gzip

	# /uploads/* 静态文件
	# 2026-10-20：修图片 404
	#   volume todo_uploads 挂在容器的 /uploads，请求 path 本身就是 /uploads/xxx
	#   → root 必须是 /（拼成 /uploads/xxx 正好命中文件）
	#   踩过的坑：root * /uploads 会拼成 /uploads/uploads/xxx → 仍然 404；
	#   省略 root 更糟，默认 root 是 /srv → /srv/uploads/xxx → 404
	handle /uploads/* {
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options "nosniff"
		root * /
		file_server
	}

	reverse_proxy web:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote}
		header_up X-Forwarded-For {remote}
		header_up X-Forwarded-Proto {scheme}
	}

	@static path /_next/static/* /icons/*
	header @static Cache-Control "public, max-age=31536000, immutable"
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# HTTP 入口：nip.io / IP（备案是给 juststartit.cn 用的，nip.io 走 IP 不受影响）
http://47.107.46.78.nip.io, http://47.107.46.78 {
	encode zstd gzip

	# /uploads/* 静态文件
	# 2026-10-20：修图片 404
	#   volume todo_uploads 挂在容器的 /uploads，请求 path 本身就是 /uploads/xxx
	#   → root 必须是 /（拼成 /uploads/xxx 正好命中文件）
	#   踩过的坑：root * /uploads 会拼成 /uploads/uploads/xxx → 仍然 404；
	#   省略 root 更糟，默认 root 是 /srv → /srv/uploads/xxx → 404
	handle /uploads/* {
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options "nosniff"
		root * /
		file_server
	}

	reverse_proxy web:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote}
		header_up X-Forwarded-For {remote}
		header_up X-Forwarded-Proto {scheme}
	}

	@static path /_next/static/* /icons/*
	header @static Cache-Control "public, max-age=31536000, immutable"
	header {
		X-Content-Type-Options "nosniff"
		-X-Frame-Options
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}