# =====================================================
# Next.js 生产 Dockerfile（standalone 模式）
# Alpine musl 需要 libssl 1.1（Prisma 5 默认 engine）
# 从 alpine 3.18 静态拷贝 libssl/libcrypto 1.1
# =====================================================

# ---------- 阶段 0: 提取 libssl1.1 ----------
FROM alpine:3.18 AS libssl
# 装 libssl1.1（alpine 3.18 最后版本有）
RUN apk add --no-cache libssl1.1

# ---------- 阶段 1: 装依赖 + 构建 ----------
FROM node:22-alpine AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /repo

# 从 alpine 3.18 拷贝 libssl 1.1（Prisma 默认 linux-musl engine 需要）
COPY --from=libssl /usr/lib/libssl.so.1.1 /usr/lib/libssl.so.1.1
COPY --from=libssl /usr/lib/libcrypto.so.1.1 /usr/lib/libcrypto.so.1.1
RUN ln -sf /usr/lib/libssl.so.1.1 /usr/lib/libssl.so.1 && \
    ln -sf /usr/lib/libcrypto.so.1.1 /usr/lib/libcrypto.so.1

# workspace 元数据
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json* ./
COPY apps/web/package.json ./apps/web/
COPY packages/db/package.json ./packages/db/

# 装依赖
RUN pnpm install --no-frozen-lockfile

# 拷贝源码
COPY apps/web ./apps/web
COPY packages/db ./packages/db

# 生成 Prisma Client（linux-musl + libssl 1.1）— 强制清除缓存重生成
RUN rm -rf /repo/packages/db/node_modules/.prisma /repo/apps/web/node_modules/.prisma /repo/node_modules/.prisma
RUN pnpm --filter @todo/db generate

# 构建 Next.js
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter web build

# ---------- 阶段 2: 运行时 ----------
FROM node:22-alpine AS runner

WORKDIR /repo

# 拷贝 libssl 1.1（Prisma engine 需要）
COPY --from=libssl /usr/lib/libssl.so.1.1 /usr/lib/libssl.so.1.1
COPY --from=libssl /usr/lib/libcrypto.so.1.1 /usr/lib/libcrypto.so.1.1
RUN ln -sf /usr/lib/libssl.so.1.1 /usr/lib/libssl.so.1 && \
    ln -sf /usr/lib/libcrypto.so.1.1 /usr/lib/libcrypto.so.1

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# 拷贝 standalone 构建产物
COPY --from=builder /repo/apps/web/.next/standalone ./
COPY --from=builder /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /repo/apps/web/public ./apps/web/public

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD wget --spider --quiet http://localhost:3000/ || exit 1

CMD ["node", "apps/web/server.js"]